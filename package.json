{
  "name": "smart-parking-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently --names \"VITE,API\" --prefix-colors \"cyan,green\" \"vite\" \"npm run backend\"",
    "frontend": "vite",
    "backend": ".venv\\Scripts\\uvicorn server:app --port 8000 --reload",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
